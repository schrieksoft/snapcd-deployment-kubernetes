{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits"
  ],
  "gitAuthor": "snapcd-bot <noreply@snapcd.io>",
  "labels": ["dependencies"],

  "kubernetes": {
    "managerFilePatterns": ["/^components/.+\\.yaml$/"]
  },

  "customManagers": [
    {
      "customType": "regex",
      "description": "appVersion in each chart, annotated with the image it tracks",
      "managerFilePatterns": ["/^charts/[^/]+/Chart\\.yaml$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\nappVersion:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],

  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "groupName": "snapcd",
      "commitMessageTopic": "snapcd packages and images",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "ignoreTests": true,
      "matchPackageNames": [
        "/^SnapCd\\./",
        "/^ghcr\\.io\\/schrieksoft\\/snapcd/"
      ],
      "enabled": true,
      "postUpgradeTasks": {
        "commands": ["install-tool helm v3.16.4", "scripts/render-kustomize.sh"],
        "fileFilters": ["components/*/generated.yaml"],
        "executionMode": "branch"
      }
    }
  ],
  "prHourlyLimit": 10,
  "prConcurrentLimit": 25,
  "branchConcurrentLimit": 25,
  "baseBranchPatterns": ["main"]
}
