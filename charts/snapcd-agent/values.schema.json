    "extraManifests": {
      "type": "array"
    },
    "global": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "externalSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "object"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        }
      }
    }
  }
}
