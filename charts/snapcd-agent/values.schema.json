        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automount": {
          "type": "boolean"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "priorityClassName": {
      "type": "string"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "sidecar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "registry": {
              "type": "string"
            },
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string"
            }
          }
        },
        "port": {
          "type": "integer"
        },
        "serverUrl": {
          "type": "string"
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "oauthToken": {
              "type": "string"
            },
            "apiKey": {
              "type": "string"
            },
            "githubToken": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "files": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "oauthToken": {
                  "type": "string"
                },
                "apiKey": {
                  "type": "string"
                },
                "githubToken": {
                  "type": "string"
                }
              }
            }
          }
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "podSecurityContext": {
          "type": "object"
        },
        "securityContext": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        },
        "readinessProbe": {
          "type": "object"
        },
        "livenessProbe": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
