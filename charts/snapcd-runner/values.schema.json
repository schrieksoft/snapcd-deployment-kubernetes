{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "snapcd-runner values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "commonLabels": {
      "type": "object"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingConfigMap": {
          "type": "string"
        },
        "existingConfigMapKey": {
          "type": "string"
        },
        "appsettings": {
          "type": "object"
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientSecret": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "ClientSecret",
            "Federated"
          ]
        },
        "audience": {
          "type": "string"
        },
        "tokenExpirationSeconds": {
          "type": "integer",
          "minimum": 600
        },
        "tokenPath": {
          "type": "string",
          "pattern": "^/.+/[^/]+$"
        },
        "projectToken": {
          "type": "boolean"
        }
      }
    },
    "ssh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "privateKey": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        },
        "keyVolume": {
          "type": "object"
        },
        "keyVolumeKey": {
          "type": "string",
          "minLength": 1
        },
        "knownHosts": {
          "type": "string"
        },
        "existingKnownHostsConfigMap": {
          "type": "string"
        },
        "existingKnownHostsConfigMapKey": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "preapprovedHooks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingConfigMap": {
          "type": "string"
        },
        "hooks": {
          "type": "object"
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "size": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array"
        },
        "mountPath": {
          "type": "string"
        }
      }
    },
    "workloadIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "azure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientId": {
              "type": "string"
            },
            "tenantId": {
              "type": "string"
            }
          }
        },
        "aws": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "roleArn": {
              "type": "string"
            }
          }
        },
        "gcp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serviceAccount": {
              "type": "string"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "automount": {
          "type": "boolean"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "updateStrategy": {
      "type": "object"
    },
    "podManagementPolicy": {
      "type": "string",
      "enum": [
        "OrderedReady",
        "Parallel"
      ]
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array"
    },
    "priorityClassName": {
      "type": "string"
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "extraVolumes": {
      "type": "array"
    },
    "extraVolumeMounts": {
      "type": "array"
    },
    "initContainers": {
      "type": "array"
    },
    "extraContainers": {
      "type": "array"
    },
    "extraManifests": {
      "type": "array"
    },
    "global": {
      "type": "object"
    },
    "enabled": {
      "type": "boolean"
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tofuVersion": {
              "type": "string"
            },
            "terraformVersion": {
              "type": "string"
            },
            "image": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "registry": {
                  "type": "string"
                },
                "repository": {
                  "type": "string"
                },
                "tag": {
                  "type": "string"
                },
                "digest": {
                  "type": "string"
                },
                "pullPolicy": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    },
    "externalSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "object"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string"
        }
      }
    }
  }
}
